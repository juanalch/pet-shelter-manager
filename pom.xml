<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.shelter</groupId>
    <artifactId>pet-shelter-manager</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <!--
        [FIX VULN-6] CWE-1104/937 — corregido en Ronda 2.
        Antes: spring-boot-starter-parent 2.1.6.RELEASE (2018) y
        jackson-databind 2.9.8 fijados a propósito, con CVEs públicos
        conocidos en su cadena de dependencias.
        Ahora: se actualiza al último release estable de la línea 2.7.x
        (última rama de Spring Boot 2 con soporte de código abierto) y
        se elimina el override manual de jackson-databind: la versión
        queda gestionada por el BOM de Spring Boot, que ya trae una
        versión sin los CVEs conocidos de la 2.9.8.
    -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>                                              <!-- [FIX VULN-6] -->
        <relativePath/>
    </parent>

    <properties>
        <java.version>1.8</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.34.0</version>
        </dependency>

        <!-- [FIX VULN-6] jackson-databind ya no se fija a mano: al quitar
             el override, Maven usa la versión que gestiona el BOM de
             spring-boot-starter-parent 2.7.18, sin los CVEs conocidos de
             la 2.9.8. -->

        <!-- [FIX VULN-4] Ronda 1: solo el módulo de criptografía de Spring
             Security (BCrypt), no el starter completo — así no se agregan
             filtros de autenticación/CSRF que cambiarían el comportamiento
             del resto de la app fuera del alcance de esta ronda. Sin
             <version>: la gestiona el BOM de Spring Boot 2.7.18. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
